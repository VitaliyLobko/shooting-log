{
  "name": "Shooters Log — облік БК і настрілу",
  "short_name": "Shooters Log",
  "description": "Облік боєприпасів, настрілу по стволах і рецептів спорядження",
  "lang": "uk",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "share_target": {
    "action": "./?go=shared",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "image", "accept": ["image/*"] }] }
  },
  "orientation": "portrait",
  "background_color": "#181c18",
  "theme_color": "#181c18",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Записати стрільбу",
      "short_name": "Стрільба",
      "url": "./?go=shot",
      "icons": [{ "src": "icons/shortcut-shot.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Нова мішень",
      "short_name": "Мішень",
      "url": "./?go=target",
      "icons": [{ "src": "icons/shortcut-target.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Таймер пострілів",
      "short_name": "Таймер",
      "url": "./?go=timer",
      "icons": [{ "src": "icons/shortcut-timer.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Тренажер сітки",
      "short_name": "Тренажер",
      "url": "./?go=sim",
      "icons": [{ "src": "icons/shortcut-sim.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
